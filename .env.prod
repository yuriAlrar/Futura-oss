# Production Environment Variables
# This file is committed to git for team development

# Node Environment
NODE_ENV=production

# AWS Configuration
AWS_REGION=us-east-1

# DynamoDB Tables (Production)
NUXT_DYNAMODB_USERS_TABLE=futura-prod-users
NUXT_DYNAMODB_TRANSACTIONS_TABLE=futura-prod-transactions
NUXT_DYNAMODB_MARKET_RATES_TABLE=futura-prod-market-rates
NUXT_DYNAMODB_SESSIONS_TABLE=futura-prod-sessions
NUXT_DYNAMODB_PERMISSIONS_TABLE=futura-prod-permissions
NUXT_DYNAMODB_BATCH_OPERATIONS_TABLE=futura-prod-batch-operations
NUXT_DYNAMODB_SEGMENTS_TABLE=futura-prod-segments
NUXT_DYNAMODB_USER_SEGMENTS_TABLE=futura-prod-user-segments
NUXT_DYNAMODB_INVITES_TABLE=futura-prod-invites

# S3 Configuration
NUXT_S3_UPLOADS_BUCKET=futura-prod-uploads

# API Configuration
API_BASE_URL=/api

NUXT_IMAGE_BASE_URL="https://resource.futura.example.com"

# Note: Cognito settings are managed via Amplify environment variables
# NUXT_PUBLIC_COGNITO_USER_POOL_ID
# NUXT_PUBLIC_COGNITO_CLIENT_ID
