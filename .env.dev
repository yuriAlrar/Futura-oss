# Development Environment Variables
# This file is committed to git for team development

# Node Environment
NODE_ENV=development

# AWS Configuration
AWS_REGION=us-east-1

# DynamoDB Tables (Development)
NUXT_DYNAMODB_USERS_TABLE=futura-dev-users
NUXT_DYNAMODB_TRANSACTIONS_TABLE=futura-dev-transactions
NUXT_DYNAMODB_MARKET_RATES_TABLE=futura-dev-market-rates
NUXT_DYNAMODB_SESSIONS_TABLE=futura-dev-sessions
NUXT_DYNAMODB_PERMISSIONS_TABLE=futura-dev-permissions
NUXT_DYNAMODB_BATCH_OPERATIONS_TABLE=futura-dev-batch-operations
NUXT_DYNAMODB_SEGMENTS_TABLE=futura-dev-segments
NUXT_DYNAMODB_USER_SEGMENTS_TABLE=futura-dev-user-segments
NUXT_DYNAMODB_INVITES_TABLE=futura-dev-invites

NUXT_IMAGE_BASE_URL="https://resource.futura.example.com"

# S3 Configuration
NUXT_S3_UPLOADS_BUCKET=futura-dev-uploads-60fbe9

# API Configuration
API_BASE_URL=/api

# Note: Cognito settings are managed via Amplify environment variables
# NUXT_PUBLIC_COGNITO_USER_POOL_ID
# NUXT_PUBLIC_COGNITO_CLIENT_ID
